[Unit]
Description=MAX-Contract verified PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/bin/bash /opt/max-contract/current/deploy/backup/postgres-backup.sh
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
