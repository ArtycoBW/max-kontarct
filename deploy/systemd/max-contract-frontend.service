[Unit]
Description=MAX-Contract Mini App
After=max-contract-backend.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maxcontract
Group=maxcontract
WorkingDirectory=/opt/max-contract/current/apps/web
EnvironmentFile=/etc/max-contract/max-contract.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
