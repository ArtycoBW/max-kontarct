# This file contains no application secrets. Restrict the real file to root (0600).
BACKUP_POSTGRES_CONTAINER=mc-postgres-prod
BACKUP_DATABASE_USER=mc_app
BACKUP_DATABASE_NAME=max_contract_v3
BACKUP_DIR=/opt/max-contract/backups
BACKUP_RETENTION_DAYS=14
# The backup job reads storage credentials from this root-only production env
# unless these BACKUP_S3_* values explicitly point at a dedicated backup account.
BACKUP_APP_ENV_FILE=/etc/max-contract/max-contract.env
# BACKUP_S3_PREFIX=private/backups/postgres
