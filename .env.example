# API foundation
NODE_ENV=development
API_PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
LOG_LEVEL=info
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# MAX authentication (real bot token is required only in production)
MAX_BOT_TOKEN=
MAX_INIT_DATA_TTL_SECONDS=3600
MAX_INIT_DATA_FUTURE_SKEW_SECONDS=30
AUTH_COOKIE_NAME=max_contract_session
AUTH_SESSION_TTL_SECONDS=604800
AUTH_REDIS_PREFIX=max-contract:auth
DEV_MAX_USER_ID=1000000000001
DEV_MAX_USERNAME=dev_max_user
DEV_MAX_FIRST_NAME=Иван
DEV_MAX_LAST_NAME=Тестовый
DEV_MAX_LANGUAGE_CODE=ru

# Production Web (same-origin /api in production, proxied locally)
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://localhost:3001

# PostgreSQL 16
POSTGRES_HOST_PORT=5434
POSTGRES_USER=max_contract
POSTGRES_PASSWORD=max_contract_dev
POSTGRES_DB=max_contract
DATABASE_URL=postgresql://max_contract:max_contract_dev@localhost:5434/max_contract
TEST_DATABASE_URL=postgresql://max_contract:max_contract_dev@localhost:5434/postgres

# Redis 7
REDIS_HOST_PORT=6381
REDIS_URL=redis://localhost:6381

# MinIO (local S3-compatible storage)
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
MINIO_ROOT_USER=max_contract
MINIO_ROOT_PASSWORD=max_contract_dev_secret
MINIO_ENDPOINT=http://localhost:9100
MINIO_ACCESS_KEY=max_contract
MINIO_SECRET_KEY=max_contract_dev_secret
MINIO_BUCKET=max-contract-dev
MINIO_REGION=ru-central1
MINIO_AUTO_CREATE_BUCKET=true
