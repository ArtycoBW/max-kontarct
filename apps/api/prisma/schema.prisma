generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPPORT

  @@map("user_role")
}

enum PhoneVerificationSource {
  MAX
  DEV

  @@map("phone_verification_source")
}

enum ConsentType {
  PERSONAL_DATA
  TERMS_OF_USE
  STATUS_NOTIFICATIONS
  ELECTRONIC_SIGNATURE

  @@map("consent_type")
}

enum ConsentSource {
  MINI_APP
  DEV_SEED

  @@map("consent_source")
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("template_version_status")
}

enum AiGenerationStatus {
  NEED_MORE_INFO
  READY_TO_GENERATE
  QUEUED
  GENERATING
  COMPLETED
  FAILED

  @@map("ai_generation_status")
}

enum DealStatus {
  DRAFT
  COLLECTING_DATA
  INVITATION_READY
  INVITED
  COUNTERPARTY_JOINED
  DOCUMENTS_PENDING
  DOCUMENTS_REVIEW
  CONTRACT_DRAFT
  TERMS_REVIEW
  READY_TO_SIGN
  SIGNED_BY_ONE
  SIGNED
  COMPLETED
  CANCELED

  @@map("deal_status")
}

enum DealPartyRole {
  INITIATOR
  COUNTERPARTY

  @@map("deal_party_role")
}

enum DealApprovalStatus {
  APPROVED
  SUPERSEDED
  REVOKED

  @@map("deal_approval_status")
}

enum TrustCheckType {
  MAX_ACCOUNT
  PHONE
  REQUISITES_FORMAT
  REQUIRED_FILES
  INTERNAL_REVIEW

  @@map("trust_check_type")
}

enum TrustCheckStatus {
  PENDING
  CONFIRMED
  REJECTED

  @@map("trust_check_status")
}

enum TrustCheckSource {
  MAX
  DEV
  PROFILE
  DADATA
  FILES
  ADMIN
  SYSTEM

  @@map("trust_check_source")
}

enum DealFileCategory {
  REQUIREMENT
  EVIDENCE

  @@map("deal_file_category")
}

enum DealFileVisibility {
  OWNER_ONLY
  DEAL_PARTICIPANTS

  @@map("deal_file_visibility")
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  role       UserRole  @default(USER)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  auditEvents    AuditEvent[]   @relation("AuditActor")
  aiGenerations  AiGeneration[]
  consents       UserConsent[]
  dealParties    DealParty[]
  dealVersions   DealVersion[]  @relation("DealVersionAuthor")
  createdDealInvitations  DealInvitation[] @relation("DealInvitationCreator")
  acceptedDealInvitations DealInvitation[] @relation("DealInvitationAcceptor")
  initiatedDeals Deal[]         @relation("DealInitiator")
  maxAccount     MaxAccount?
  phones         UserPhone[]
  profile        UserProfile?
  sessions       UserSession[]
  trustChecks    UserTrustCheck[]
  dealFiles      DealFile[]       @relation("DealFileOwner")

  @@index([role], map: "users_role_idx")
  @@map("users")
}

model MaxAccount {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique(map: "max_accounts_user_id_key") @map("user_id") @db.Uuid
  maxUserId           String    @unique(map: "max_accounts_max_user_id_key") @map("max_user_id") @db.VarChar(128)
  username            String?   @db.VarChar(128)
  firstName           String?   @map("first_name") @db.VarChar(128)
  lastName            String?   @map("last_name") @db.VarChar(128)
  languageCode        String?   @map("language_code") @db.VarChar(16)
  lastAuthenticatedAt DateTime? @map("last_authenticated_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("max_accounts")
}

model UserSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  sessionHash String    @unique(map: "user_sessions_session_hash_key") @map("session_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "user_sessions_expires_at_idx")
  @@index([userId, revokedAt], map: "user_sessions_user_id_revoked_at_idx")
  @@map("user_sessions")
}

model UserPhone {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @map("user_id") @db.Uuid
  e164       String                  @unique(map: "user_phones_e164_key") @db.VarChar(16)
  source     PhoneVerificationSource
  verifiedAt DateTime                @map("verified_at") @db.Timestamptz(3)
  isPrimary  Boolean                 @default(false) @map("is_primary")
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "user_phones_user_id_idx")
  @@map("user_phones")
}

model UserProfile {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique(map: "user_profiles_user_id_key") @map("user_id") @db.Uuid
  firstName  String    @map("first_name") @db.VarChar(100)
  lastName   String    @map("last_name") @db.VarChar(100)
  middleName String?   @map("middle_name") @db.VarChar(100)
  email      String?   @db.VarChar(254)
  birthDate  DateTime? @map("birth_date") @db.Date
  addressValue        String?   @map("address_value") @db.VarChar(500)
  addressSource       String?   @map("address_source") @db.VarChar(16)
  addressFiasId       String?   @map("address_fias_id") @db.VarChar(64)
  addressKladrId      String?   @map("address_kladr_id") @db.VarChar(64)
  addressPostalCode   String?   @map("address_postal_code") @db.VarChar(16)
  addressRegion       String?   @map("address_region") @db.VarChar(160)
  addressCity         String?   @map("address_city") @db.VarChar(160)
  addressStreet       String?   @map("address_street") @db.VarChar(160)
  addressHouse        String?   @map("address_house") @db.VarChar(64)
  addressQualityCode  String?   @map("address_quality_code") @db.VarChar(16)
  addressNormalizedAt DateTime? @map("address_normalized_at") @db.Timestamptz(3)
  locale     String?   @db.VarChar(16)
  timezone   String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserTrustCheck {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      TrustCheckType
  status    TrustCheckStatus @default(PENDING)
  source    TrustCheckSource
  checkedAt DateTime?        @map("checked_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type], map: "user_trust_checks_user_type_key")
  @@index([type, status, updatedAt], map: "user_trust_checks_type_status_updated_idx")
  @@map("user_trust_checks")
}

model UserConsent {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  type            ConsentType
  documentVersion String        @map("document_version") @db.VarChar(64)
  documentHash    String?       @map("document_hash") @db.Char(64)
  granted         Boolean
  source          ConsentSource
  recordedAt      DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, documentVersion], map: "user_consents_user_type_version_key")
  @@index([userId, type, createdAt], map: "user_consents_user_type_created_at_idx")
  @@map("user_consents")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(128)
  entityType  String?  @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.VarChar(128)
  requestId   String?  @map("request_id") @db.VarChar(128)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt], map: "audit_events_actor_created_at_idx")
  @@index([entityType, entityId, createdAt], map: "audit_events_entity_created_at_idx")
  @@index([eventType, createdAt], map: "audit_events_type_created_at_idx")
  @@index([requestId], map: "audit_events_request_id_idx")
  @@map("audit_events")
}

model ContractTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique(map: "contract_templates_slug_key") @db.VarChar(100)
  title     String   @db.VarChar(160)
  summary   String   @db.VarChar(500)
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions ContractTemplateVersion[]

  @@index([isDemo, title], map: "contract_templates_demo_title_idx")
  @@map("contract_templates")
}

model ContractTemplateVersion {
  id                  String                @id @default(uuid()) @db.Uuid
  templateId          String                @map("template_id") @db.Uuid
  versionNumber       Int                   @map("version_number")
  status              TemplateVersionStatus @default(DRAFT)
  questionnaireSchema Json                  @map("questionnaire_schema")
  publishedAt         DateTime?             @map("published_at") @db.Timestamptz(3)
  archivedAt          DateTime?             @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  documentRequirements TemplateDocumentRequirement[]
  aiGenerations        AiGeneration[]
  deals                Deal[]
  template             ContractTemplate              @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, versionNumber], map: "contract_template_versions_template_version_key")
  @@index([status, publishedAt], map: "contract_template_versions_status_published_idx")
  @@index([templateId, status, versionNumber], map: "contract_template_versions_template_status_version_idx")
  @@map("contract_template_versions")
}

model AiGeneration {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  templateVersionId    String             @map("template_version_id") @db.Uuid
  status               AiGenerationStatus
  inputAnswers         Json               @map("input_answers")
  questions            Json
  clarificationAnswers Json?              @map("clarification_answers")
  providerMetadata     Json               @map("provider_metadata")
  promptId             String             @map("prompt_id") @db.VarChar(64)
  promptVersion        String             @map("prompt_version") @db.VarChar(32)
  structuredDraft      Json?              @map("structured_draft")
  failureCode          String?            @map("failure_code") @db.VarChar(64)
  attemptCount         Int                @default(0) @map("attempt_count")
  queuedAt             DateTime?          @map("queued_at") @db.Timestamptz(3)
  startedAt            DateTime?          @map("started_at") @db.Timestamptz(3)
  failedAt             DateTime?          @map("failed_at") @db.Timestamptz(3)
  completedAt          DateTime?          @map("completed_at") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealVersion     DealVersion?
  templateVersion ContractTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt], map: "ai_generations_user_created_at_idx")
  @@index([userId, status, updatedAt], map: "ai_generations_user_status_updated_idx")
  @@index([templateVersionId, status], map: "ai_generations_template_status_idx")
  @@map("ai_generations")
}

model Deal {
  id                String     @id @default(uuid()) @db.Uuid
  initiatorUserId   String     @map("initiator_user_id") @db.Uuid
  templateVersionId String     @map("template_version_id") @db.Uuid
  title             String     @db.VarChar(160)
  status            DealStatus @default(DRAFT)
  canceledAt        DateTime?  @map("canceled_at") @db.Timestamptz(3)
  completedAt       DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  initiator       User                    @relation("DealInitiator", fields: [initiatorUserId], references: [id], onDelete: Restrict)
  templateVersion ContractTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  parties         DealParty[]
  versions        DealVersion[]
  invitations     DealInvitation[]
  files           DealFile[]

  @@index([initiatorUserId, status, updatedAt], map: "deals_initiator_status_updated_idx")
  @@index([status, updatedAt], map: "deals_status_updated_idx")
  @@index([templateVersionId], map: "deals_template_version_id_idx")
  @@map("deals")
}

model DealInvitation {
  id               String    @id @default(uuid()) @db.Uuid
  dealId           String    @map("deal_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  acceptedByUserId String?   @map("accepted_by_user_id") @db.Uuid
  publicCode       String    @unique(map: "deal_invitations_public_code_key") @map("public_code") @db.VarChar(24)
  tokenHash        String    @unique(map: "deal_invitations_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  acceptedBy User? @relation("DealInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdBy  User  @relation("DealInvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  deal       Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt], map: "deal_invitations_deal_created_idx")
  @@index([expiresAt], map: "deal_invitations_expires_at_idx")
  @@index([acceptedByUserId], map: "deal_invitations_accepted_by_user_id_idx")
  @@map("deal_invitations")
}

model DealParty {
  id        String        @id @default(uuid()) @db.Uuid
  dealId    String        @map("deal_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  role      DealPartyRole
  joinedAt  DateTime      @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  approvals DealApproval[]
  deal      Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([dealId, role], map: "deal_parties_deal_role_key")
  @@unique([dealId, userId], map: "deal_parties_deal_user_key")
  @@unique([id, dealId], map: "deal_parties_id_deal_id_key")
  @@index([userId, joinedAt], map: "deal_parties_user_joined_idx")
  @@map("deal_parties")
}

model DealVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  dealId             String   @map("deal_id") @db.Uuid
  createdByUserId    String   @map("created_by_user_id") @db.Uuid
  sourceGenerationId String?  @unique(map: "deal_versions_source_generation_id_key") @map("source_generation_id") @db.Uuid
  versionNumber      Int      @map("version_number")
  terms              Json
  contractDraft      Json?    @map("contract_draft")
  changeSummary      String?  @map("change_summary") @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  approvals        DealApproval[]
  createdBy        User           @relation("DealVersionAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  deal             Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  sourceGeneration AiGeneration?  @relation(fields: [sourceGenerationId], references: [id], onDelete: SetNull)

  @@unique([dealId, versionNumber], map: "deal_versions_deal_version_key")
  @@unique([id, dealId], map: "deal_versions_id_deal_id_key")
  @@index([dealId, createdAt], map: "deal_versions_deal_created_idx")
  @@index([createdByUserId], map: "deal_versions_created_by_user_id_idx")
  @@map("deal_versions")
}

model DealApproval {
  id            String             @id @default(uuid()) @db.Uuid
  dealId        String             @map("deal_id") @db.Uuid
  dealVersionId String             @map("deal_version_id") @db.Uuid
  partyId       String             @map("party_id") @db.Uuid
  status        DealApprovalStatus @default(APPROVED)
  approvedAt    DateTime           @default(now()) @map("approved_at") @db.Timestamptz(3)
  invalidatedAt DateTime?          @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  dealVersion DealVersion @relation(fields: [dealVersionId, dealId], references: [id, dealId], onDelete: Cascade)
  party       DealParty   @relation(fields: [partyId, dealId], references: [id, dealId], onDelete: Cascade)

  @@unique([dealVersionId, partyId], map: "deal_approvals_version_party_key")
  @@index([partyId, status], map: "deal_approvals_party_status_idx")
  @@index([dealVersionId, status], map: "deal_approvals_version_status_idx")
  @@map("deal_approvals")
}

model DealFile {
  id              String             @id @default(uuid()) @db.Uuid
  dealId          String             @map("deal_id") @db.Uuid
  ownerUserId     String             @map("owner_user_id") @db.Uuid
  requirementId   String?            @map("requirement_id") @db.Uuid
  category        DealFileCategory
  visibility      DealFileVisibility
  bucket          String             @db.VarChar(128)
  objectKey       String             @unique(map: "deal_files_object_key_key") @map("object_key") @db.VarChar(255)
  originalName    String             @map("original_name") @db.VarChar(255)
  mimeType        String             @map("mime_type") @db.VarChar(100)
  sizeBytes       BigInt             @map("size_bytes")
  sha256          String             @db.Char(64)
  uploadedAt      DateTime           @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  deal        Deal                         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  owner       User                         @relation("DealFileOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  requirement TemplateDocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@index([dealId, category, uploadedAt], map: "deal_files_deal_category_uploaded_idx")
  @@index([ownerUserId, uploadedAt], map: "deal_files_owner_uploaded_idx")
  @@index([requirementId], map: "deal_files_requirement_id_idx")
  @@map("deal_files")
}

model TemplateDocumentRequirement {
  id                String   @id @default(uuid()) @db.Uuid
  templateVersionId String   @map("template_version_id") @db.Uuid
  key               String   @db.VarChar(64)
  title             String   @db.VarChar(160)
  description       String?  @db.VarChar(500)
  required          Boolean  @default(true)
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  templateVersion ContractTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  files           DealFile[]

  @@unique([templateVersionId, key], map: "template_document_requirements_version_key_key")
  @@index([templateVersionId, sortOrder], map: "template_document_requirements_version_sort_idx")
  @@map("template_document_requirements")
}
