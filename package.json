{
  "name": "max-contract",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names design,web,api --prefix-colors blue,green,magenta \"npm run dev:design\" \"npm run dev:web\" \"npm run dev:api\"",
    "dev:design": "npm run dev --workspace @max-contract/design-review",
    "dev:web": "npm run dev --workspace @max-contract/web",
    "dev:api": "npm run dev --workspace @max-contract/api",
    "ai:smoke": "npm run ai:smoke --workspace @max-contract/api",
    "dev:role": "npm run dev:role --workspace @max-contract/api --",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "postinstall": "npm run prisma:generate && npm run build --workspace @max-contract/contracts",
    "prisma:generate": "npm run prisma:generate --workspace @max-contract/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @max-contract/api",
    "prisma:seed": "npm run prisma:seed --workspace @max-contract/api",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:ps": "docker compose -f docker-compose.dev.yml ps"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "prisma@6.12.0": true
  }
}
